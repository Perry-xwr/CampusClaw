MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
SESSION_TTL_HOURS=24
MAX_UPLOAD_BYTES=1048576
WEB_PORT=8080
QDRANT_COLLECTION=campusclaw_chunks
EMBEDDING_BASE_URL=http://model-mock:8081
EMBEDDING_API_KEY=
EMBEDDING_MODEL=campusclaw-mock-embedding
EMBEDDING_DIMENSION=16
# Optional OpenAI-compatible Chat provider. Keep Chat credentials in local .env only.
# If CHAT_* is unset, Compose can map the equivalent GLM_* variables.
CHAT_BASE_URL=http://model-mock:8081
CHAT_API_KEY=
CHAT_MODEL=campusclaw-mock-chat
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4-flash-250414
MODEL_TIMEOUT_SECONDS=60
# Optional real OpenAI-compatible chat provider: set CHAT_BASE_URL to its API base,
# CHAT_MODEL to the provider model ID, and CHAT_API_KEY in your local .env only.
# Example GLM values: https://open.bigmodel.cn/api/paas/v4 and glm-4.7-flash.
# Keep embeddings on model-mock unless using an embedding provider with the configured 16 dimensions.
VECTOR_MIN_SCORE=0.35
KEYWORD_MIN_SCORE=0.01
# Generate a private random value locally and set MCP_AUTH_TOKEN in .env/runtime environment.
# The same value is injected into api and mcp-demo; never commit or print it.
# Optional local test-only request-body tracing; acceptance enables it for mock services only.
# CAMPUSCLAW_TEST_TRACE=false
